{
  "info": {
    "name": "Mini API Project",
    "description": "Requests for the local Mini API Project endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns healthy status', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().status).to.eql('healthy');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Country details",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/countries/Japan"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns country, currency, and capital', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.country).to.eql('Japan');",
              "    pm.expect(body.currency).to.eql('JPY');",
              "    pm.expect(body.capital).to.eql('Tokyo');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Travel budget",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/roam/Japan?budget_inr=150000"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns a converted travel budget', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.country).to.eql('Japan');",
              "    pm.expect(body.budget_inr).to.eql(150000);",
              "    pm.expect(body.budget_local).to.be.a('number');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown country",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/countries/Atlantis"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns not found for an unknown country', function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid travel budget",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/roam/Japan?budget_inr=0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rejects a budget that is not positive', function () {",
              "    pm.response.to.have.status(422);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing travel budget",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/roam/Japan"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Requires a travel budget', function () {",
              "    pm.response.to.have.status(422);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Trips",
      "item": [
        {
          "name": "Create trip",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const date = new Date();",
                  "date.setDate(date.getDate() + 30);",
                  "pm.collectionVariables.set('futureTravelDate', [date.getFullYear(), String(date.getMonth() + 1).padStart(2, '0'), String(date.getDate()).padStart(2, '0')].join('-'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Creates a trip', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const trip = pm.response.json();",
                  "    pm.expect(trip.id).to.be.a('number');",
                  "    pm.collectionVariables.set('tripId', trip.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"traveller\": \"Asha\",\n  \"country\": \"Japan\",\n  \"budget_inr\": 150000,\n  \"travel_date\": \"{{futureTravelDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/trips"
          }
        },
        {
          "name": "List trips",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lists trips with converted budgets', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const trips = pm.response.json();",
                  "    pm.expect(trips).to.be.an('array');",
                  "    if (trips.length > 0) {",
                  "        pm.expect(trips[0].rate).to.be.a('number');",
                  "        pm.expect(trips[0].budget_local).to.be.a('number');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/trips"
          }
        },
        {
          "name": "Get trip",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns the saved trip', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('tripId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/trips/{{tripId}}"
          }
        },
        {
          "name": "Update trip",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Updates the supplied trip fields', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(Number(pm.response.json().budget_inr)).to.eql(120000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"budget_inr\": 120000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/trips/{{tripId}}"
          }
        },
        {
          "name": "Delete trip",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Deletes the trip without a response body', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/trips/{{tripId}}"
          }
        },
        {
          "name": "Past travel date is rejected",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const date = new Date();",
                  "date.setDate(date.getDate() - 1);",
                  "pm.collectionVariables.set('pastTravelDate', [date.getFullYear(), String(date.getMonth() + 1).padStart(2, '0'), String(date.getDate()).padStart(2, '0')].join('-'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejects a past travel date', function () {",
                  "    pm.response.to.have.status(422);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"traveller\": \"Asha\",\n  \"country\": \"Japan\",\n  \"budget_inr\": 150000,\n  \"travel_date\": \"{{pastTravelDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/trips"
          }
        },
        {
          "name": "Zero budget is rejected",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const date = new Date();",
                  "date.setDate(date.getDate() + 30);",
                  "pm.collectionVariables.set('futureTravelDate', [date.getFullYear(), String(date.getMonth() + 1).padStart(2, '0'), String(date.getDate()).padStart(2, '0')].join('-'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejects a zero budget', function () {",
                  "    pm.response.to.have.status(422);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"traveller\": \"Asha\",\n  \"country\": \"Japan\",\n  \"budget_inr\": 0,\n  \"travel_date\": \"{{futureTravelDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/trips"
          }
        },
        {
          "name": "Missing trip is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns not found for a missing trip', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/trips/99999"
          }
        }
      ]
    }
  ]
}
