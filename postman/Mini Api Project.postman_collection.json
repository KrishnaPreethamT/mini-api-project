{
  "info": {
    "name": "Mini API Project",
    "description": "Requests for the local Mini API Project endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns healthy status', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().status).to.eql('healthy');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Country details",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/countries/Japan"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns country, currency, and capital', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.country).to.eql('Japan');",
              "    pm.expect(body.currency).to.eql('JPY');",
              "    pm.expect(body.capital).to.eql('Tokyo');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Travel budget",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/roam/Japan?budget_inr=150000"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns a converted travel budget', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.country).to.eql('Japan');",
              "    pm.expect(body.budget_inr).to.eql(150000);",
              "    pm.expect(body.budget_local).to.be.a('number');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown country",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/countries/Atlantis"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns not found for an unknown country', function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid travel budget",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/roam/Japan?budget_inr=0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rejects a budget that is not positive', function () {",
              "    pm.response.to.have.status(422);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing travel budget",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/roam/Japan"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Requires a travel budget', function () {",
              "    pm.response.to.have.status(422);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
